# Dynamic version (VITE_DATA_MODE=dynamic) — server-side variables for the Vercel functions in /api.

# Postgres connection string (Vercel Postgres / Neon integration sets DATABASE_URL or POSTGRES_URL).
DATABASE_URL=postgres://user:password@host/db

# Secret used to encrypt the stored OneStock API passwords (16+ characters). Never change it once
# passwords are stored, or they will have to be entered again.
CREDENTIALS_KEY=change-me-to-a-long-random-string

# Optional: key required to change the connection settings (asked in the hidden Settings tab).
SETTINGS_ADMIN_KEY=

# Local tests only: route OneStock calls to a fake server.
# ONESTOCK_BASE_URL_TEMPLATE=http://localhost:4010/{env}/{site_id}
